{
  "name": "jev-ui",
  "version": "0.0.2",
  "description": "Resolve which component to render, how to order a list, and whether to show an affordance \u2014 from calibrated judgments returned by TypeSafe's Jev.",
  "keywords": [
    "react",
    "nextjs",
    "typesafe",
    "jev",
    "ui",
    "ranking",
    "system-one"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "default": "./dist/action.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.0",
    "react": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etweisberg/jev-ui.git",
    "directory": "packages/jev-ui"
  },
  "homepage": "https://github.com/etweisberg/jev-ui#readme",
  "bugs": {
    "url": "https://github.com/etweisberg/jev-ui/issues"
  }
}
