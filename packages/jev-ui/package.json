{
  "name": "jev-ui",
  "version": "0.0.1",
  "description": "Resolve which component to render, how to order a list, and whether to show an affordance \u2014 from calibrated judgments returned by TypeSafe's Jev.",
  "keywords": [
    "react",
    "nextjs",
    "typesafe",
    "jev",
    "ui",
    "ranking",
    "system-one"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.0",
    "react": "^19.0.0"
  }
}
