{
  "name": "jev-ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter jev-ui build",
    "test": "bun run --filter jev-ui test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --filter demo dev",
    "record": "bun run --filter demo record",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "next": "^15.1.0"
  }
}
